.DS_Store
leilao-app/node_modules
leilao-app/dist

# ---------------------------------------------------------------------------
# Arquivos que sao da MAQUINA de desenvolvimento, e nao do projeto.
#
# Sao scripts que sobem o ambiente local completo, com caminhos
# apontando para as ferramentas instaladas fora do repositorio (o
# Maven, o PostgreSQL e o JDK em "C:\Users\...\Documents\AZ\_tools").
# Nao fazem sentido para quem clona o projeto - e o caminho absoluto
# no meio do repositorio entrega o nome da pasta e o nome do usuario.
#
# O "docker-database.yml" continua no Git: ele e' o caminho oficial
# para subir o banco, e nao depende de nada da maquina.
# ---------------------------------------------------------------------------

# O ".env" real. Quem quiser rodar com outros valores copia o
# ".env.example" (que esta' no Git) e aponta o "env_file" do compose
# para a copia.
.env

# Os scripts que sobem o ambiente local completo.
iniciar.ps1
parar.ps1

# Os scripts locais de demonstracao e apresentacao.
scripts/
testar-ataque-403.bat
testar-erro-400.bat
.claude/

# O painel de testes (a ferramenta de apresentacao).
painel-testes/

# Arquivos de ambiente do frontend.
#
# O padrao do projeto e' o mesmo em toda parte:
#
#   ".env"         -> os valores reais (com segredo)
#   ".env.example" -> o modelo (as chaves, sem os valores)
#
# O ".env" do frontend NAO deve ir para o Git: ele e' lido pelo Vue CLI
# e vira codigo que chega ao navegador. O que vai para o Git e o
# ".env.example", que tem as chaves e o formato, sem os valores reais.
#
# Neste projeto o ".env" do frontend tem apenas a URL publica da API
# (nao ha segredo nele), e por isso foi versionado junto com o codigo -
# para que o avaliador clone e rode sem etapa extra. Se alguma vez ele
# passar a carregar credencial, a regra abaixo passa a valer.
leilao-app/.env.local
leilao-app/.env.*.local

.env.local

# Os ".env.example" sao modelos: eles vao para o Git de proposito. As
# regras acima nao os pegam porque nao casam com nenhum dos padroes.
!leilao-app/.env.example
!.env.example

# Log files
leilao-app/npm-debug.log*
leilao-app/yarn-debug.log*
leilao-app/yarn-error.log*

# Logs gerados pela API (Spring Boot / Logback). Sao arquivos de
# execucao: nao pertencem ao codigo-fonte e nao devem ser versionados.
leilao-api/logs/
*.log

# Editor directories and files
.idea
leilao-app/.vscode
leilao-app/*.suo
leilao-app/*.ntvs*
leilao-app/*.njsproj
leilao-app/*.sln
leilao-app/*.sw?

leilao-api/iHELP.md
leilao-api/target
leilao-api/!.mvn/wrapper/maven-wrapper.jar
leilao-api/!**/src/main/**
leilao-api/!**/src/test/**

### STS ###
leilao-api/.apt_generated
leilao-api/.classpath
leilao-api/.factorypath
leilao-api/.project
leilao-api/.settings
leilao-api/.springBeans
leilao-api/.sts4-cache

### IntelliJ IDEA ###
leilao-api/*.iws
leilao-api/*.iml
leilao-api/*.ipr

### NetBeans ###
leilao-api/nbproject/private/
leilao-api/nbbuild/
leilao-api/dist/
leilao-api/nbdist/
leilao-api/.nb-gradle/
leilao-api/build/

### VS Code ###
leilao-api/.vscode/

# O package-lock.json e versionado de proposito: e o arquivo que fixa
# exatamente quais versoes de cada dependencia serao instaladas. Com ele no
# Git, quem rodar "npm install" recebe a mesma arvore de dependencias
# testada aqui - sem risco de uma versao nova quebrar o build.
!leilao-app/package-lock.json

# A chave HMAC que a aplicacao esta' usando na trilha de auditoria.
#
# O arquivo guarda qual chave selou os registros ja gravados. Se a chave
# mudar, a trilha precisa recomecar - e e' esse arquivo que permite
# saber isso. Ele e' local de proposito: em producao a chave vem do
# secret do orquestrador, e nao de um arquivo no disco.
.audit-hmac.state
