<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuracao de log dos testes (logback-test.xml).

  Vale apenas durante "mvn test": deixa o log limpo, sem as mensagens de
  DEBUG do Spring Test, para que o resultado da suite fique legivel. O log
  da aplicacao em producao nao e afetado - ele vem do logback-spring.xml.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Silencia o Spring Test e o Hibernate durante os testes. -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="br.com.selecao.locadora" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
