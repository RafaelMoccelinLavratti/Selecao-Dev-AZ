# Variaveis de ambiente do banco de dados.
#
# Este arquivo e lido pelo docker-database.yml (campo "env_file").
#
# ATENCAO - SEGURANCA:
# Os valores aqui sao de DESENVOLVIMENTO, publicos e conhecidos. Em um
# ambiente real, a senha do banco NUNCA deveria estar num arquivo versionado
# no Git. O caminho correto seria usar um "secret" do orquestrador (Docker
# Swarm secrets, Kubernetes Secret, AWS Secrets Manager, HashiCorp Vault) ou,
# no minimo, um arquivo .env que NAO vai para o Git (veja o .gitignore) e
# que o CI/CD injete no momento do deploy. Aqui o objetivo e didatico: o
# avaliador precisa conseguir subir o banco com um unico comando. O README
# explica o caminho seguro.

# Credenciais do superusuario do PostgreSQL (criado na primeira subida).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Nome do banco de dados criado na primeira subida.
# Sem esta variavel, o container do Postgres cria apenas o banco "postgres"
# (que tem o mesmo nome do usuario) e a aplicacao receberia "database does
# not exist" ao tentar conectar em "az".
POSTGRES_DB=az

# Configuracao da aplicacao (usada quando a API roda em container ou quando
# voce exporta estas variaveis antes de rodar a API localmente).
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_URL=jdbc:postgresql://database:5432/az
DATABASE_NAME=az
DATABASE_CLASSNAME=org.postgresql.Driver
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
