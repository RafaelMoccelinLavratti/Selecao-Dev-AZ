# Modelo das variaveis de ambiente do banco de dados.
#
# Este arquivo e o "exemplo" do ".env": mostra as chaves e o
# formato, sem os valores reais. Serve para duas coisas:
#
#   1) quem quiser rodar o projeto fora do padrao sabe quais variaveis
#      existem e o que cada uma faz;
#   2) como referencia para quem precisar gerar o ".env" de um
#      ambiente novo.
#
# O ".env" de verdade NAO esta no Git - ele carrega a senha do
# banco. Copie este arquivo, ajuste os valores e comece de onde ele
# precisa:
#
#     cp .env.example .env
#
# No ambiente de desenvolvimento deste projeto, o ".env" esta
# versionado de proposito: as credenciais ali sao publicas, de
# desenvolvimento, e o avaliador precisa conseguir subir o banco com um
# unico comando. Em qualquer ambiente real, a senha vai para um secret do
# orquestrador (Docker Swarm, Kubernetes Secret, AWS Secrets Manager,
# HashiCorp Vault) - nunca para um arquivo no Git.

# Credenciais do superusuario do PostgreSQL (criado na primeira subida).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Nome do banco de dados criado na primeira subida.
POSTGRES_DB=az

# ---------------------------------------------------------------------------
# Configuracao da aplicacao
# ---------------------------------------------------------------------------
#
# O host e "localhost" porque a API roda na propria maquina, e nao
# dentro do Compose. Se a API rodar como container do mesmo Compose, o
# host passa a ser o nome do servico do banco ("postgresql").
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/az
DATABASE_NAME=az
DATABASE_CLASSNAME=org.postgresql.Driver
DATABASE_USER=postgres
DATABASE_PASSWORD=troque-esta-senha
DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
