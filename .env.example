# Variaveis de ambiente do banco de dados.
#
# Este arquivo e' lido pelo "docker-database.yml" (campo "env_file").
#
# ---------------------------------------------------------------------------
# ATENCAO - SEGURANCA
# ---------------------------------------------------------------------------
#
# Os valores aqui sao de DESENVOLVIMENTO, publicos e conhecidos. Em um
# ambiente real, a senha do banco NUNCA deveria estar num arquivo
# versionado no Git. O caminho correto seria usar um "secret" do
# orquestrador (Docker Swarm secrets, Kubernetes Secret, AWS Secrets
# Manager, HashiCorp Vault) e injetar o valor na hora do deploy.
#
# Aqui o objetivo e' didatico: o avaliador precisa conseguir subir o banco
# com um unico comando, sem criar arquivo nenhum. Por isso este arquivo
# existe em vez de um ".env" separado - e por isso ele se chama
# ".example" mesmo assim: e' o modelo do arquivo, com o conteudo real de
# desenvolvimento, e nao um segredo.
#
# Se quiser rodar com outros valores (uma senha sua, um banco em outro
# lugar), copie este arquivo, ajuste e aponte o "env_file" do compose
# para a copia - sem versionar a copia.

# Credenciais do superusuario do PostgreSQL (criado na primeira subida).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Nome do banco de dados criado na primeira subida.
# Sem esta variavel, o container do Postgres cria apenas o banco "postgres"
# (que tem o mesmo nome do usuario) e a aplicacao receberia "database does
# not exist" ao tentar conectar em "az".
POSTGRES_DB=az

# ---------------------------------------------------------------------------
# Configuracao da aplicacao
# ---------------------------------------------------------------------------
#
# Estas variaveis sao exportadas antes de rodar a API localmente
# ("mvn spring-boot:run"). O "application.properties" le a "DATABASE_URL" e
# usa "jdbc:postgresql://localhost:5432/az" como valor padrao quando ela
# nao esta no ambiente.
#
# O host e "localhost", e nao "database", porque a API roda na propria
# maquina, e nao dentro do Compose. O nome "database" so resolve dentro da
# rede interna do Docker Compose - e o Compose deste projeto nao tem
# nenhum servico com esse nome. Um "localhost" aqui esta certo; o
# equivalente para o container seria "postgresql", o nome do servico.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/az
DATABASE_NAME=az
DATABASE_CLASSNAME=org.postgresql.Driver
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
