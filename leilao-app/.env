# =============================================================================
#  .env  |  Configuracao do frontend (Vue CLI le este arquivo)
# =============================================================================
#  ATENCAO: este arquivo e lido pelo FRONTEND, ou seja, ele vira
#  codigo que chega ao navegador do usuario. NUNCA coloque aqui uma
#  senha, um token ou qualquer segredo - isso seria visivel por
#  qualquer pessoa que abrir o "ver codigo-fonte" da pagina.
#
#  O prefixo VUE_APP_ e obrigatorio: o Vue CLI so expoe ao frontend
#  as variaveis de ambiente que comecam com esse prefixo.
# =============================================================================

# Endereco base da API Spring Boot.
# Local  : http://localhost:8081
# Docker : http://localhost:8081 (o compose expoe a porta 8081 tambem)
VUE_APP_API_BASE_URL=http://localhost:8081
