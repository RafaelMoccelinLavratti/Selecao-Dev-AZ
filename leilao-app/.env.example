# Modelo da configuracao do frontend.
#
# Este arquivo e o "exemplo" do ".env": mostra as chaves e o formato,
# sem os valores reais.
#
# O ".env" de verdade e lido pelo Vue CLI e pelos seus arquivos. Ele NAO
# esta no Git em um projeto real, porque qualquer arquivo lido pelo
# frontend vira codigo que chega ao navegador do usuario.
#
# Para gerar o seu:
#
#     cp .env.example .env
#
# O "npm run serve" le o ".env" automaticamente. Depois de mudar o
# arquivo, e preciso reiniciar o servidor de desenvolvimento.

# Endereco base da API Spring Boot.
#
# Local  : http://localhost:8081
# Docker : http://localhost:8081 (o compose expoe a porta 8081 tambem)
#
# Este valor e publico por natureza: ele vai parar no bundle do
# frontend. NUNCA coloque aqui uma senha, um token ou qualquer segredo -
# isso seria visivel para qualquer pessoa que abrir o "ver codigo-fonte"
# da pagina.
VUE_APP_API_BASE_URL=http://localhost:8081
